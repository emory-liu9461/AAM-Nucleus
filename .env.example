# Postgres connection string
DATABASE_URL=postgres://nucleus:nucleus@localhost:5432/nucleus

# Setup code: only used once, on the first-run screen, to create the first owner
# account. After that everyone signs in with their own email + password.
OWNER_PASSWORD=change-me

# Signs login sessions. Long random string (e.g. `openssl rand -hex 32`).
# Changing it signs everyone out.
AUTH_SECRET=generate-a-long-random-string

# Public address of this app, used in the website embed code and links (optional;
# defaults to the address you're viewing the app on).
# APP_URL=https://app.yourcompany.com
