# Address of your Nucleus app. The website reads its content from here and
# sends quote requests here. No database credentials are needed on the website.
NUCLEUS_URL=https://app.yourcompany.com

# OPTIONAL. Each business's website is chosen by its own domain, so this isn't needed.
# It only picks which business shows on the bare preview address (*.vercel.app,
# localhost). Without it, preview any business with ?site=<slug>.
# DEFAULT_SITE=business-one
